{
  "name": "flashlab",
  "productName": "FlashLab",
  "description": "Clon local de Notion: Electron + React + Editor.js, todo en tu disco.",
  "author": "flashlab",
  "private": true,
  "version": "0.1.86",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,green \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "release": "node scripts/release.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.5",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.flashlab.app",
    "productName": "FlashLab",
    "directories": {
      "output": "C:/flashlab-build/release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/lib/textExtract.js",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "node_modules/ffmpeg-static/**/*",
      "!node_modules/@capacitor/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "edwardgko",
      "repo": "flashlab-releases",
      "releaseType": "release"
    }
  }
}
